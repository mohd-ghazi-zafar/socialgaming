const crypto = require("crypto");
const {
    getOrCreateChat,
    getChatById,
    sendMessage,
    markMessagesRead
} = require("../module/chat/privateChatModule");

const onlineUsers = new Map(); // userId -> Set of socketIds (supports multiple tabs/devices)

const generateChatUid = () => {
    const year = new Date().getFullYear();
    const randomDigits = crypto.randomInt(100000, 999999);
    return `CHAT-${randomDigits}-${year}`;
};

const initChatSocket = (io) => {
    io.on("connection", (socket) => {
        console.log("Client connected:", socket.id);

        // 1. Register user online & join personal room for inbox updates
        socket.on("user_online", (userId) => {
            if (!userId) return;
            const uid = String(userId);
            socket.userId = uid;

            if (!onlineUsers.has(uid)) {
                onlineUsers.set(uid, new Set());
            }
            onlineUsers.get(uid).add(socket.id);

            socket.join(`user_${uid}`);
            io.emit("online_users", Array.from(onlineUsers.keys()));
        });

        // 2. Join active 1-on-1 chat room
        socket.on("join_chat", (chatId) => {
            if (!chatId) return;
            socket.join(`chat_${chatId}`);
        });

        // 3. Leave active 1-on-1 chat room
        socket.on("leave_chat", (chatId) => {
            if (!chatId) return;
            socket.leave(`chat_${chatId}`);
        });

        // 4. Send message directly via Socket.IO (Text / Emoji / Sticker)
        socket.on("send_message", async (payload, callback) => {
            try {
                const {
                    chat_id,
                    sender_id,
                    receiver_id,
                    message_type = "text",
                    content = null,
                    media_url = null,
                    media_duration = null,
                    file_name = null,
                    file_size = null,
                    reply_to_message_id = null
                } = payload;

                if (!sender_id || (!chat_id && !receiver_id)) {
                    if (callback) callback({ success: false, message: "sender_id and chat_id/receiver_id required" });
                    return;
                }

                let chat = chat_id ? await getChatById(chat_id) : null;
                if (!chat && receiver_id) {
                    chat = await getOrCreateChat(sender_id, receiver_id, generateChatUid());
                }

                if (!chat) {
                    if (callback) callback({ success: false, message: "Chat room not found" });
                    return;
                }

                const actualReceiverId =
                    Number(chat.user1_id) === Number(sender_id)
                        ? Number(chat.user2_id)
                        : Number(chat.user1_id);

                const savedMessage = await sendMessage({
                    chat_id: chat.id,
                    sender_id: Number(sender_id),
                    receiver_id: actualReceiverId,
                    message_type,
                    content: content ? content.trim() : null,
                    media_url,
                    media_duration,
                    file_name,
                    file_size,
                    reply_to_message_id
                });

                // Broadcast to everyone inside the chat room (including sender & receiver)
                io.to(`chat_${chat.id}`).emit("new_message", savedMessage);

                // Notify receiver's personal room to update inbox list & unread counter
                io.to(`user_${actualReceiverId}`).emit("inbox_updated", {
                    chat_id: chat.id,
                    chat_uid: chat.chat_uid,
                    message: savedMessage
                });

                if (callback) callback({ success: true, data: savedMessage });
            } catch (err) {
                console.error("Socket send_message error:", err.message);
                if (callback) callback({ success: false, message: err.message });
            }
        });

        // 5. Typing indicators
        socket.on("typing", ({ chat_id, sender_id }) => {
            if (!chat_id) return;
            socket.to(`chat_${chat_id}`).emit("user_typing", { chat_id, sender_id });
        });

        socket.on("stop_typing", ({ chat_id, sender_id }) => {
            if (!chat_id) return;
            socket.to(`chat_${chat_id}`).emit("user_stop_typing", { chat_id, sender_id });
        });

        // 6. Real-time read receipts (Blue ticks)
        socket.on("mark_read", async ({ chat_id, reader_id }) => {
            try {
                if (!chat_id || !reader_id) return;
                const updatedRows = await markMessagesRead(chat_id, reader_id);
                const readMessageIds = updatedRows.map((row) => row.id);

                if (readMessageIds.length > 0) {
                    io.to(`chat_${chat_id}`).emit("messages_read", {
                        chat_id: Number(chat_id),
                        reader_id: Number(reader_id),
                        read_message_ids: readMessageIds
                    });
                }
            } catch (err) {
                console.error("Socket mark_read error:", err.message);
            }
        });

        // 7. Disconnect cleanup
        socket.on("disconnect", () => {
            if (socket.userId && onlineUsers.has(socket.userId)) {
                const userSockets = onlineUsers.get(socket.userId);
                userSockets.delete(socket.id);
                if (userSockets.size === 0) {
                    onlineUsers.delete(socket.userId);
                }
            }
            io.emit("online_users", Array.from(onlineUsers.keys()));
            console.log("Client disconnected:", socket.id);
        });
    });
};

module.exports = initChatSocket;


