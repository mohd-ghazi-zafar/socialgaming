const crypto = require("crypto");
const {
    getOrCreateChat,
    getChatById,
    getUserChats,
    sendMessage,
    getChatMessages,
    markMessagesRead,
    toggleMessageReaction,
    editMessage,
    deleteMessage,
    togglePinMessage,
    searchChatMessages
} = require("../../module/chat/privateChatModule");

const generateChatUid = () => {
    const year = new Date().getFullYear();
    const randomDigits = crypto.randomInt(100000, 999999);
    return `CHAT-${randomDigits}-${year}`;
};

const formatFileSize = (bytes) => {
    if (!bytes) return null;
    if (bytes < 1024 * 1024) {
        return `${(bytes / 1024).toFixed(1)} KB`;
    }
    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
};


// 1. START OR GET 1-ON-1 CHAT ROOM
const startOrGetChat = async (req, res) => {
    try {
        const senderId = req.user.id;
        const receiverId = req.params.receiverId;

        if (!receiverId) {
            return res.status(400).json({ message: "Receiver player ID is required" });
        }

        if (Number(senderId) === Number(receiverId)) {
            return res.status(400).json({ message: "You cannot start a chat with yourself" });
        }

        const chatUid = generateChatUid();
        const chat = await getOrCreateChat(senderId, receiverId, chatUid);

        return res.status(200).json({
            message: "Chat room ready",
            chat
        });
    } catch (err) {
        console.error("startOrGetChat error:", err.message);
        if (err.code === "23503") {
            return res.status(404).json({ message: "Player not found" });
        }
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 2. GET USER'S INBOX
const viewInbox = async (req, res) => {
    try {
        const userId = req.user.id;
        const chats = await getUserChats(userId);

        return res.status(200).json({
            message: "Inbox fetched successfully",
            count: chats.length,
            chats
        });
    } catch (err) {
        console.error("viewInbox error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 3. SEND MESSAGE (REST + REAL-TIME SOCKET EMIT)
const sendChatMessage = async (req, res) => {
    try {
        const senderId = Number(req.user.id);
        const chatIdentifier = req.params.chatId;
        const {
            message_type,
            content,
            media_duration,
            reply_to_message_id
        } = req.body;

        const chat = await getChatById(chatIdentifier);
        if (!chat) {
            return res.status(404).json({ message: "Chat room not found" });
        }

        if (Number(chat.user1_id) !== senderId && Number(chat.user2_id) !== senderId) {
            return res.status(403).json({ message: "Access denied to this chat room" });
        }

        const receiverId =
            Number(chat.user1_id) === senderId
                ? Number(chat.user2_id)
                : Number(chat.user1_id);

        const allowedTypes = ["text", "voice", "image", "video", "file", "sticker"];
        const msgType = message_type && allowedTypes.includes(message_type)
            ? message_type
            : req.file
                ? "file"
                : "text";

        let mediaUrl = req.body?.media_url || null;
        let fileName = req.body?.file_name || null;
        let fileSize = req.body?.file_size || null;

        if (req.file) {
            const baseUrl = `${req.protocol}://${req.get("host")}`;
            mediaUrl = `${baseUrl}/uploads/chat/${req.file.filename}`;
            fileName = req.file.originalname;
            fileSize = formatFileSize(req.file.size);
        }

        if (msgType === "text" && (!content || content.trim() === "")) {
            return res.status(400).json({ message: "Message content cannot be empty" });
        }

        if (msgType !== "text" && !mediaUrl && !content) {
            return res.status(400).json({ message: `Media file is required for ${msgType} message` });
        }

        const savedMessage = await sendMessage({
            chat_id: chat.id,
            sender_id: senderId,
            receiver_id: receiverId,
            message_type: msgType,
            content: content ? content.trim() : null,
            media_url: mediaUrl,
            media_duration: media_duration ? parseInt(media_duration, 10) : null,
            file_name: fileName,
            file_size: fileSize,
            reply_to_message_id: reply_to_message_id ? parseInt(reply_to_message_id, 10) : null
        });

        // Emit real-time Socket.IO events
        const io = req.app.get("io");
        if (io) {
            io.to(`chat_${chat.id}`).emit("new_message", savedMessage);
            io.to(`user_${receiverId}`).emit("inbox_updated", {
                chat_id: chat.id,
                chat_uid: chat.chat_uid,
                message: savedMessage
            });
        }

        return res.status(201).json({
            message: msgType === "voice" ? "Voice message sent" : "Message sent",
            data: savedMessage
        });
    } catch (err) {
        console.error("sendChatMessage error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 4. GET CHAT HISTORY
const viewChatHistory = async (req, res) => {
    try {
        const userId = Number(req.user.id);
        const chatIdentifier = req.params.chatId;
        const limit = parseInt(req.query.limit, 10) || 50;
        const offset = parseInt(req.query.offset, 10) || 0;

        const chat = await getChatById(chatIdentifier);
        if (!chat) {
            return res.status(404).json({ message: "Chat room not found" });
        }

        if (Number(chat.user1_id) !== userId && Number(chat.user2_id) !== userId) {
            return res.status(403).json({ message: "Access denied to this chat room" });
        }

        const messages = await getChatMessages(chat.id, userId, limit, offset);

        return res.status(200).json({
            message: "Chat history fetched successfully",
            chat_id: chat.id,
            chat_uid: chat.chat_uid,
            count: messages.length,
            messages
        });
    } catch (err) {
        console.error("viewChatHistory error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 5. MARK MESSAGES AS READ
const markChatAsRead = async (req, res) => {
    try {
        const readerId = Number(req.user.id);
        const chatIdentifier = req.params.chatId;

        const chat = await getChatById(chatIdentifier);
        if (!chat) {
            return res.status(404).json({ message: "Chat room not found" });
        }

        if (Number(chat.user1_id) !== readerId && Number(chat.user2_id) !== readerId) {
            return res.status(403).json({ message: "Access denied to this chat room" });
        }

        const updatedRows = await markMessagesRead(chat.id, readerId);
        const readMessageIds = updatedRows.map((row) => row.id);

        const io = req.app.get("io");
        if (io && readMessageIds.length > 0) {
            io.to(`chat_${chat.id}`).emit("messages_read", {
                chat_id: chat.id,
                reader_id: readerId,
                read_message_ids: readMessageIds
            });
        }

        return res.status(200).json({
            message: "Messages marked as read",
            chat_id: chat.id,
            read_message_ids: readMessageIds
        });
    } catch (err) {
        console.error("markChatAsRead error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


