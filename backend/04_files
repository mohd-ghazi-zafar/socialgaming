        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 8. DELETE MESSAGE
const removeChatMessage = async (req, res) => {
    try {
        const userId = req.user.id;
        const messageId = req.params.messageId;
        const forEveryone = req.query.forEveryone === "true" || req.body?.forEveryone === true;

        const deletedMessage = await deleteMessage(messageId, userId, forEveryone);
        if (!deletedMessage) {
            return res.status(404).json({ message: "Message not found or you cannot delete it for everyone" });
        }

        const io = req.app.get("io");
        if (io && forEveryone) {
            io.to(`chat_${deletedMessage.chat_id}`).emit("message_deleted", {
                message_id: deletedMessage.id,
                chat_id: deletedMessage.chat_id
            });
        }

        return res.status(200).json({
            message: forEveryone ? "Message deleted for everyone" : "Message deleted for you",
            data: deletedMessage
        });
    } catch (err) {
        console.error("removeChatMessage error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


