    const uploadedFile = req.file || req.files?.voice?.[0] || null;
    if (!uploadedFile) {
        return res.status(400).json({ message: "Voice audio file ('voice') is required" });
    }
    req.body.message_type = "voice";
    return sendChatMessage(req, res);
};



