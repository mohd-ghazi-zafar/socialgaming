const uploadChatMedia = require("../../middleware/uploadprivatechat");
const { verifyToken } = require("../../middleware/jwtauthication");

// Mounted at /api/chatroute
router.get("/inbox", verifyToken, viewInbox);
router.get("/status/:userId", verifyToken, fetchUserOnlineStatus);
router.post("/start/:receiverId", verifyToken, startOrGetChat);

// Message & Voice Note Actions
router.put("/message/:messageId/played", verifyToken, voiceNotePlayed);
router.put("/message/:messageId/react", verifyToken, reactToMessage);
router.put("/message/:messageId/edit", verifyToken, editChatMessage);
router.put("/message/:messageId/pin", verifyToken, pinChatMessage);
router.delete("/message/:messageId", verifyToken, removeChatMessage);

// Send Voice Note, General Media/Text, History, Read & Search
router.post("/:chatId/voice", verifyToken, uploadChatMedia.single("voice"), sendVoiceNote);
// router.post("/:chatId/send", verifyToken, uploadChatMedia.single("media"), sendChatMessage);

router.post(
    "/:chatId/send",
    verifyToken,
    uploadChatMedia.fields([
        { name: "media", maxCount: 1 },
        { name: "voice", maxCount: 1 }
    ]),
    sendChatMessage
);
router.get("/:chatId/messages", verifyToken, viewChatHistory);
router.put("/:chatId/read", verifyToken, markChatAsRead);
router.get("/:chatId/search", verifyToken, searchMessagesInChat);

module.exports = router;
