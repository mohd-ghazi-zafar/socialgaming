// controllers/AuthController.js
const bcrypt = require("bcrypt");
const jwt = require("jsonwebtoken");
const crypto = require("crypto");
const {
    saveOtp,
    verifyOtpRecord,
    createPhoneUser,
    upsertSocialUser,
    findUserForLogin,
    getAllUsers
} = require("../module/signupModule");

const JWT_SECRET = process.env.JWT_SECRET || "your_jwt_secret_key";

// Helper: Generate Unique User ID (e.g.,G-839201-2026)
const generateUniqueUserId = () => {
    const year = new Date().getFullYear();
    const randomDigits = crypto.randomInt(100000, 999999);
    return `G-${randomDigits}-${year}`;
};

// Helper: Generate 6-digit OTP
const generateSixDigitOtp = () => {
    return String(crypto.randomInt(100000, 999999));
};

// Helper: Generate JWT Token
const signToken = (user) => {
    return jwt.sign(
        {
            id: user.id,
            user_uid: user.user_uid,
            role: user.role
        },
        JWT_SECRET,
    );
};

// =====================================================
// 1. SEND 6-DIGIT OTP FOR PHONE SIGNUP
// POST /api/auth/phone/send-otp
// =====================================================
const sendPhoneOtp = async (req, res) => {
    try {
        const { phone_number } = req.body;

        if (!phone_number) {
            return res.status(400).json({
                message: "Phone number is required"
            });
        }

        const existingUser = await findUserForLogin(phone_number);
        if (existingUser) {
            return res.status(400).json({
                message: "Phone number is already registered"
            });
        }

        const otpCode = generateSixDigitOtp();
        const expiresAt = new Date(Date.now() + 5 * 60 * 1000); // 5 minutes expiry

        await saveOtp(phone_number, otpCode, expiresAt);
        console.log(`[OTP GENERATED] Phone: ${phone_number} | OTP: ${otpCode} | Expires at: ${expiresAt.toISOString()}`)

        const io = req.app.get("io");
        if (io) {
            io.emit("otp_generated", { phone_number, status: "sent" });
        }

        return res.status(200).json({
            message: "6-digit OTP generated successfully",
            phone_number,
            otp: otpCode // Remove once SMS provider is connected
        });
    } catch (err) {
        console.error("sendPhoneOtp error:", err.message);
        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

// =====================================================
// 2. PHONE SIGNUP WITH OTP, PASSWORD, PROFILE IMAGE & ROLE
// POST /api/auth/phone/signup
// =====================================================
const signupWithPhone = async (req, res) => {
    try {
        const {
            phone_number,
            otp,
            password,
            confirm_password,
            name,
            gender,
            age,
            role
        } = req.body;

        // ---------------------------------------------
        // VALIDATE REQUIRED FIELDS
        // ---------------------------------------------
        if (!phone_number || !otp || !password || !confirm_password || !name) {
            return res.status(400).json({
                message: "Phone number, OTP, password, confirm password, and name are required"
            });
        }

        if (password !== confirm_password) {
            return res.status(400).json({
                message: "Password and confirm password do not match"
            });
        }

        if (password.length < 6) {
            return res.status(400).json({
                message: "Password must be at least 6 characters long"
            });
        }

        const allowedRoles = ["user", "admin"];
        const userRole = role && allowedRoles.includes(role) ? role : "user";

        // ---------------------------------------------
        // VERIFY 6-DIGIT OTP
        // ---------------------------------------------
        const validOtp = await verifyOtpRecord(phone_number, otp);
        if (!validOtp) {
            return res.status(400).json({
                message: "Invalid or expired 6-digit OTP"
            });
        }

        // ---------------------------------------------
        // BUILD PROFILE IMAGE URL USING BASE URL
        // ---------------------------------------------
        let profileImageUrl = null;
        if (req.file) {
            const baseUrl = `${req.protocol}://${req.get("host")}`;
            profileImageUrl = `${baseUrl}/uploads/profiles/${req.file.filename}`;
        }

        // ---------------------------------------------
        // HASH PASSWORD & GENERATE UNIQUE USER ID
        // ---------------------------------------------
        const saltRounds = 10;
        const passwordHash = await bcrypt.hash(password, saltRounds);
        const uniqueUserId = generateUniqueUserId();

        const newUser = await createPhoneUser({
            user_uid: uniqueUserId,
            role: userRole,
            phone_number,
            password_hash: passwordHash,
            name,
            gender: gender || null,
            age: age ? parseInt(age, 10) : null,
            profile_image: profileImageUrl
        });

        const token = signToken(newUser);

        const io = req.app.get("io");
        if (io) {
            io.emit("user_registered", {
                user_uid: newUser.user_uid,
                name: newUser.name,
                role: newUser.role
            });
        }

        return res.status(201).json({
            message: "Signup successful. Save your unique ID for login.",
            unique_id: newUser.user_uid,
            token,
            user: newUser
        });
    } catch (err) {
        console.error("signupWithPhone error:", err.message);

        if (err.code === "23505") {
            return res.status(400).json({
                message: "User with this phone number or ID already exists"
            });
        }

        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

// =====================================================
// 3. LOGIN USING UNIQUE ID (user_uid) & PASSWORD
// POST /api/auth/login
// =====================================================
const loginWithUniqueId = async (req, res) => {
    try {
        const { unique_id, password } = req.body;

        if (!unique_id || !password) {
            return res.status(400).json({
                message: "Unique ID and password are required"
            });
        }

        const user = await findUserForLogin(unique_id.trim());

        if (!user || user.auth_provider !== "phone") {
            return res.status(404).json({
                message: "Invalid Unique ID or account not found"
            });
        }

        const isPasswordValid = await bcrypt.compare(password, user.password_hash);
        if (!isPasswordValid) {
            return res.status(401).json({
                message: "Invalid password"
            });
        }

        const token = signToken(user);
        const { password_hash, ...safeUser } = user;

        return res.status(200).json({
            message: "Login successful",
            token,
            user: safeUser
        });
    } catch (err) {
        console.error("loginWithUniqueId error:", err.message);
        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

// =====================================================
// 4. SOCIAL SIGNUP / LOGIN (GOOGLE, APPLE, FACEBOOK, SNAPCHAT)
// POST /api/auth/social
// =====================================================
const socialAuth = async (req, res) => {
    try {
        const {
            provider,
            provider_id,
            email,
            name,
            gender,
            age,
            profile_image,
            role
        } = req.body;

        const allowedProviders = ["google", "apple", "facebook", "snapchat"];

        if (!provider || !allowedProviders.includes(provider.toLowerCase())) {
            return res.status(400).json({
                message: "Provider must be one of: google, apple, facebook, snapchat"
            });
        }

        if (!provider_id || !name) {
            return res.status(400).json({
                message: "provider_id and name are required"
            });
        }

        const allowedRoles = ["user", "admin"];
        const userRole = role && allowedRoles.includes(role) ? role : "user";

        const uniqueUserId = generateUniqueUserId();

        const { user, isNewUser } = await upsertSocialUser({
            user_uid: uniqueUserId,
            role: userRole,
            auth_provider: provider.toLowerCase(),
            provider_id,
            email: email || null,
            name,
            gender: gender || null,
            age: age ? parseInt(age, 10) : null,
            profile_image: profile_image || null
        });

        const token = signToken(user);

        return res.status(isNewUser ? 201 : 200).json({
            message: isNewUser
                ? `Signed up with ${provider} successfully`
                : `Logged in with ${provider} successfully`,
            unique_id: user.user_uid,
            token,
            user
        });
    } catch (err) {
        console.error("socialAuth error:", err.message);

        if (err.code === "23505") {
            return res.status(400).json({
                message: "Email already linked with another account"
            });
        }

        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

// =====================================================
// 5. GET ALL USERS
// GET /api/auth/users
// =====================================================
const viewAllUsers = async (req, res) => {
    try {
        const users = await getAllUsers();
        return res.status(200).json({
            message: "Users fetched successfully",
            users
        });
    } catch (err) {
        console.error("viewAllUsers error:", err.message);
        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

// =====================================================
// UPDATE USER
// PUT /api/auth/users/update/:id
// =====================================================
const editUser = async (req, res) => {
    try {
        const userId = req.params.id?.trim();

        if (!userId) {
            return res.status(400).json({
                message: "User ID or Unique ID is required"
            });
        }

        const updateData = { ...req.body };

        // Validate role if provided
        if (updateData.role) {
            const allowedRoles = ["user", "admin"];
            if (!allowedRoles.includes(updateData.role)) {
                return res.status(400).json({
                    message: "Invalid role. Allowed roles: user, admin"
                });
            }
        }

        // Hash password if updating password
        if (updateData.password) {
            if (
                updateData.confirm_password &&
                updateData.password !== updateData.confirm_password
            ) {
                return res.status(400).json({
                    message: "Password and confirm password do not match"
                });
            }
            if (updateData.password.length < 6) {
                return res.status(400).json({
                    message: "Password must be at least 6 characters long"
                });
            }
            updateData.password_hash = await bcrypt.hash(updateData.password, 10);
            delete updateData.password;
            delete updateData.confirm_password;
        }

        // Parse age to integer if provided
        if (updateData.age !== undefined && updateData.age !== "") {
            updateData.age = parseInt(updateData.age, 10);
        }

        // Update profile image path using base URL if new file uploaded via Multer
        if (req.file) {
            const baseUrl = `${req.protocol}://${req.get("host")}`;
            updateData.profile_image = `${baseUrl}/uploads/profiles/${req.file.filename}`;
        }

        const updatedUser = await updateUser(userId, updateData);

        if (!updatedUser) {
            return res.status(404).json({
                message: "User not found"
            });
        }

        const io = req.app.get("io");
        if (io) {
            io.emit("user_updated", updatedUser);
        }

        return res.status(200).json({
            message: "User updated successfully",
            user: updatedUser
        });
    } catch (err) {
        console.error("editUser error:", err.message);

        if (err.code === "23505") {
            return res.status(400).json({
                message: "Phone number or email already in use"
            });
        }

        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

// =====================================================
// DELETE USER
// DELETE /api/auth/users/delete/:id
// =====================================================
const removeUser = async (req, res) => {
    try {
        const userId = req.params.id?.trim();

        if (!userId) {
            return res.status(400).json({
                message: "User ID or Unique ID is required"
            });
        }

        const deletedUser = await deleteUser(userId);

        if (!deletedUser) {
            return res.status(404).json({
                message: "User not found"
            });
        }

        const io = req.app.get("io");
        if (io) {
            io.emit("user_deleted", { user_uid: deletedUser.user_uid });
        }

        return res.status(200).json({
            message: "User deleted successfully",
            user: deletedUser
        });
    } catch (err) {
        console.error("removeUser error:", err.message);
        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};

module.exports = {
    sendPhoneOtp,
    signupWithPhone,
    loginWithUniqueId,
    socialAuth,
    viewAllUsers,
    editUser,
    removeUser
};