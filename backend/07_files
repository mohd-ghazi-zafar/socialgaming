const toggleGroupReaction = async (messageId, userId, emoji) => {
    const existing = await pool.query(`SELECT reactions, group_id FROM group_messages WHERE id = $1`, [messageId]);
    if (!existing.rows[0]) return null;

    const reactions = existing.rows[0].reactions || {};
    const key = String(userId);
    if (!emoji || reactions[key] === emoji) {
        delete reactions[key];
    } else {
        reactions[key] = emoji;
    }

    const res = await pool.query(
        `UPDATE group_messages SET reactions = $1::jsonb, updated_at = CURRENT_TIMESTAMP WHERE id = $2 RETURNING *`,
        [JSON.stringify(reactions), messageId]
    );
    return res.rows[0];
};

const editGroupMessage = async (messageId, senderId, newContent) => {
    const res = await pool.query(
        `
        UPDATE group_messages
        SET content = $1, is_edited = TRUE, updated_at = CURRENT_TIMESTAMP
        WHERE id = $2 AND sender_id = $3 AND message_type = 'text' AND is_deleted_for_everyone = FALSE
        RETURNING *
        `,
        [newContent, messageId, senderId]
    );
    return res.rows[0] || null;
};

const deleteGroupMessage = async (messageId, userId, isAdminOrOwner = false, deleteForEveryone = false) => {
    if (deleteForEveryone) {
        // Sender OR group admin/owner can delete for everyone
        const query = isAdminOrOwner
            ? `UPDATE group_messages SET content = 'This message was deleted', media_url = NULL, is_deleted_for_everyone = TRUE, updated_at = CURRENT_TIMESTAMP WHERE id = $1 RETURNING *`
            : `UPDATE group_messages SET content = 'This message was deleted', media_url = NULL, is_deleted_for_everyone = TRUE, updated_at = CURRENT_TIMESTAMP WHERE id = $1 AND sender_id = $2 RETURNING *`;
        const params = isAdminOrOwner ? [messageId] : [messageId, userId];
        const res = await pool.query(query, params);
        return res.rows[0] || null;
    }

    const res = await pool.query(
        `
        UPDATE group_messages
        SET deleted_for_users = CASE
            WHEN NOT (deleted_for_users @> to_jsonb($2::int)) THEN deleted_for_users || to_jsonb($2::int)
            ELSE deleted_for_users
        END
        WHERE id = $1
        RETURNING *
        `,
        [messageId, Number(userId)]
    );
    return res.rows[0] || null;
};

const togglePinGroupMessage = async (messageId) => {
    const res = await pool.query(
        `UPDATE group_messages SET is_pinned = NOT is_pinned, updated_at = CURRENT_TIMESTAMP WHERE id = $1 RETURNING *`,
        [messageId]
    );
    return res.rows[0] || null;
};

const searchGroupMessages = async (groupId, currentUserId, searchTerm) => {
    const res = await pool.query(
        `
        SELECT * FROM group_messages
        WHERE group_id = $1
          AND is_deleted_for_everyone = FALSE
          AND NOT (deleted_for_users @> to_jsonb($2::int))
          AND content ILIKE $3
        ORDER BY created_at DESC
        `,
        [groupId, Number(currentUserId), `%${searchTerm}%`]
    );
    return res.rows;
};

