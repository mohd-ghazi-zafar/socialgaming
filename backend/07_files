const getGroupDetails = async (identifier) => {
    const isNumeric = /^\d+$/.test(String(identifier));
    const column = isNumeric ? "g.id" : "g.group_uid";

    const groupRes = await pool.query(
        `SELECT g.* FROM groups g WHERE ${column} = $1 LIMIT 1`,
        [identifier]
    );
    const group = groupRes.rows[0];
    if (!group) return null;

    const membersRes = await pool.query(
        `
        SELECT
            gm.user_id,
            gm.role,
            gm.is_muted,
            gm.joined_at,
            u.user_uid,
            u.name,
            u.profile_image,
            u.is_online,
            u.last_seen
        FROM group_members gm
        JOIN users u ON u.id = gm.user_id
        WHERE gm.group_id = $1
        ORDER BY
            CASE gm.role WHEN 'owner' THEN 1 WHEN 'admin' THEN 2 ELSE 3 END,
            gm.joined_at ASC
        `,
        [group.id]
    );

    return {
        ...group,
        member_count: membersRes.rows.length,
        members: membersRes.rows
    };
};


