const crypto = require("crypto");
const {
    getOrCreateChat,
    getChatById,
    sendMessage,
    markMessagesRead,
    setUserOnlineStatus,
    getUserOnlineStatus
} = require("../module/chat/privateChatModule");

const onlineUsers = new Map(); // userId -> Set of socketIds

const generateChatUid = () => {
    const year = new Date().getFullYear();
    const randomDigits = crypto.randomInt(100000, 999999);
    return `CHAT-${randomDigits}-${year}`;
};

const initChatSocket = (io) => {
    io.on("connection", (socket) => {
        console.log("Client connected:", socket.id);

        // =====================================================
        // 1. ONLINE STATUS & PRESENCE (SHARED FOR PRIVATE + GROUP)
        // =====================================================
        socket.on("user_online", async (userId) => {
            try {
                if (!userId) return;
                const uid = String(userId);
                socket.userId = uid;

                const isFirstConnection = !onlineUsers.has(uid);
                if (isFirstConnection) {
                    onlineUsers.set(uid, new Set());
                }
                onlineUsers.get(uid).add(socket.id);
                socket.join(`user_${uid}`);

                if (isFirstConnection) {
                    const statusRow = await setUserOnlineStatus(uid, true);
                    io.emit("user_status_changed", {
                        user_id: Number(uid),
                        is_online: true,
                        last_seen: statusRow?.last_seen || new Date().toISOString()
                    });
                }

                io.emit("online_users", Array.from(onlineUsers.keys()));
            } catch (err) {
                console.error("Socket user_online error:", err.message);
            }
        });

        socket.on("check_user_status", async (targetUserId, callback) => {
            try {
                if (!targetUserId) return;
                const isCurrentlyConnected = onlineUsers.has(String(targetUserId));
                const dbStatus = await getUserOnlineStatus(targetUserId);

                const payload = {
                    user_id: Number(targetUserId),
                    is_online: isCurrentlyConnected || Boolean(dbStatus?.is_online),
                    last_seen: dbStatus?.last_seen || null
                };

                if (callback) callback({ success: true, data: payload });
            } catch (err) {
                console.error("Socket check_user_status error:", err.message);
                if (callback) callback({ success: false, message: err.message });
            }
        });

        // =====================================================
        // 2. PRIVATE 1-ON-1 CHAT EVENTS
        // =====================================================
        socket.on("join_chat", (chatId) => {
            if (chatId) socket.join(`chat_${chatId}`);
        });

        socket.on("leave_chat", (chatId) => {
            if (chatId) socket.leave(`chat_${chatId}`);
        });

        socket.on("send_message", async (payload, callback) => {
            try {
                const {
                    chat_id,
                    sender_id,
                    receiver_id,
                    message_type = "text",
                    content = null,
                    media_url = null,
                    media_duration = null,
                    waveform = [],
                    reply_to_message_id = null
                } = payload;

                if (!sender_id || (!chat_id && !receiver_id)) {
                    if (callback) callback({ success: false, message: "sender_id and chat_id/receiver_id required" });
                    return;
                }

                let chat = chat_id ? await getChatById(chat_id) : null;
                if (!chat && receiver_id) {
                    chat = await getOrCreateChat(sender_id, receiver_id, generateChatUid());
                }

                if (!chat) {
                    if (callback) callback({ success: false, message: "Chat room not found" });
                    return;
                }

                const actualReceiverId =
                    Number(chat.user1_id) === Number(sender_id)
                        ? Number(chat.user2_id)
                        : Number(chat.user1_id);

                const savedMessage = await sendMessage({
                    chat_id: chat.id,
                    sender_id: Number(sender_id),
                    receiver_id: actualReceiverId,
                    message_type,
                    content: content ? content.trim() : null,
                    media_url,
                    media_duration,
                    waveform,
                    reply_to_message_id
                });

                io.to(`chat_${chat.id}`).emit("new_message", savedMessage);
                io.to(`user_${actualReceiverId}`).emit("inbox_updated", {
                    chat_id: chat.id,
                    chat_uid: chat.chat_uid,
                    message: savedMessage
                });

                if (callback) callback({ success: true, data: savedMessage });
            } catch (err) {
                console.error("Socket send_message error:", err.message);
                if (callback) callback({ success: false, message: err.message });
            }
        });

        socket.on("typing", ({ chat_id, sender_id }) => {
            if (chat_id) socket.to(`chat_${chat_id}`).emit("user_typing", { chat_id, sender_id });
        });

        socket.on("stop_typing", ({ chat_id, sender_id }) => {
            if (chat_id) socket.to(`chat_${chat_id}`).emit("user_stop_typing", { chat_id, sender_id });
        });

        socket.on("recording_voice", ({ chat_id, sender_id }) => {
            if (chat_id) socket.to(`chat_${chat_id}`).emit("user_recording_voice", { chat_id, sender_id });
        });

        socket.on("stop_recording_voice", ({ chat_id, sender_id }) => {
            if (chat_id) socket.to(`chat_${chat_id}`).emit("user_stop_recording_voice", { chat_id, sender_id });
        });

        socket.on("mark_read", async ({ chat_id, reader_id }) => {
            try {
                if (!chat_id || !reader_id) return;
                const updatedRows = await markMessagesRead(chat_id, reader_id);
                const readMessageIds = updatedRows.map((row) => row.id);

                if (readMessageIds.length > 0) {
                    io.to(`chat_${chat_id}`).emit("messages_read", {
                        chat_id: Number(chat_id),
                        reader_id: Number(reader_id),
                        read_message_ids: readMessageIds
                    });
                }
            } catch (err) {
                console.error("Socket mark_read error:", err.message);
            }
        });

        // =====================================================
        // 3. GROUP CHAT EVENTS
        // =====================================================
        socket.on("join_group", (groupId) => {
            if (groupId) socket.join(`group_${groupId}`);
        });

        socket.on("leave_group", (groupId) => {
            if (groupId) socket.leave(`group_${groupId}`);
        });

        socket.on("group_typing", ({ group_id, sender_id, sender_name }) => {
            if (group_id) socket.to(`group_${group_id}`).emit("group_user_typing", { group_id, sender_id, sender_name });
        });

        socket.on("group_stop_typing", ({ group_id, sender_id }) => {
            if (group_id) socket.to(`group_${group_id}`).emit("group_user_stop_typing", { group_id, sender_id });
        });

        socket.on("group_recording_voice", ({ group_id, sender_id, sender_name }) => {
            if (group_id) socket.to(`group_${group_id}`).emit("group_user_recording_voice", { group_id, sender_id, sender_name });
        });

        socket.on("group_stop_recording_voice", ({ group_id, sender_id }) => {
            if (group_id) socket.to(`group_${group_id}`).emit("group_user_stop_recording_voice", { group_id, sender_id });
        });

        // =====================================================
        // 4. DISCONNECT CLEANUP
        // =====================================================
        socket.on("disconnect", async () => {
            try {
                if (socket.userId && onlineUsers.has(socket.userId)) {
                    const uid = socket.userId;
                    const userSockets = onlineUsers.get(uid);
                    userSockets.delete(socket.id);

                    if (userSockets.size === 0) {
                        onlineUsers.delete(uid);
                        const statusRow = await setUserOnlineStatus(uid, false);

                        io.emit("user_status_changed", {
                            user_id: Number(uid),
                            is_online: false,
                            last_seen: statusRow?.last_seen || new Date().toISOString()
                        });
                    }
                }
                io.emit("online_users", Array.from(onlineUsers.keys()));
                console.log("Client disconnected:", socket.id);
            } catch (err) {
                console.error("Socket disconnect error:", err.message);
            }
        });
    });
};

module.exports = initChatSocket;