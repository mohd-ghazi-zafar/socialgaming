} = require("../../module/chat/groupChatModule");

const generateGroupUid = () => `GRP-${crypto.randomInt(100000, 999999)}-${new Date().getFullYear()}`;
const generateInviteCode = () => crypto.randomBytes(6).toString("hex");

const formatFileSize = (bytes) => {
    if (!bytes) return null;
    return bytes < 1024 * 1024
        ? `${(bytes / 1024).toFixed(1)} KB`
        : `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
};


// 1. CREATE GROUP (FROM PRIVATE CHAT OR INBOX)
const createNewGroup = async (req, res) => {
    try {
        const createdBy = Number(req.user.id);
        const { name, description } = req.body;

        if (!name || name.trim() === "") {
            return res.status(400).json({ message: "Group name is required" });
        }

        // Parse member_ids (supports JSON array or comma-separated string from form-data)
        let memberIds = [];
        if (req.body.member_ids) {
            if (Array.isArray(req.body.member_ids)) {
                memberIds = req.body.member_ids;
            } else {
                try {
                    memberIds = JSON.parse(req.body.member_ids);
                } catch (_) {
                    memberIds = String(req.body.member_ids).split(",").map((id) => id.trim());
                }
            }
        }

        const uploadedIcon = req.file || req.files?.media?.[0] || req.files?.group_image?.[0] || null;
        let groupImageUrl = null;
        if (uploadedIcon) {
            const baseUrl = `${req.protocol}://${req.get("host")}`;
            groupImageUrl = `${baseUrl}/uploads/chat/${uploadedIcon.filename}`;
        }

        const group = await createGroup({
            group_uid: generateGroupUid(),
            name: name.trim(),
            description: description ? description.trim() : null,
            group_image: groupImageUrl,
            created_by: createdBy,
            invite_code: generateInviteCode(),
            member_ids: memberIds
        });

        // Notify all added members via Socket.IO
        const io = req.app.get("io");
        if (io && group?.members) {
            group.members.forEach((m) => {
                io.to(`user_${m.user_id}`).emit("group_created", group);
            });
        }

        return res.status(201).json({
            message: "Group created successfully",
            group
        });
    } catch (err) {
        console.error("createNewGroup error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


