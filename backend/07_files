// 6. ADD MEMBERS (ADMIN / OWNER ONLY)
const addMembersToGroup = async (req, res) => {
    try {
        const actorId = Number(req.user.id);
        const group = await getGroupDetails(req.params.groupId);
        if (!group) return res.status(404).json({ message: "Group not found" });

        const actor = await getMemberRole(group.id, actorId);
        if (!actor || actor.role === "member") {
            return res.status(403).json({ message: "Only group admins can add members" });
        }

        const { user_ids } = req.body;
        if (!Array.isArray(user_ids) || user_ids.length === 0) {
            return res.status(400).json({ message: "user_ids array is required" });
        }

        const added = await addGroupMembers(group.id, actorId, user_ids);
        const updatedGroup = await getGroupDetails(group.id);

        const io = req.app.get("io");
        if (io) {
            io.to(`group_${group.id}`).emit("group_updated", updatedGroup);
            added.forEach((uid) => io.to(`user_${uid}`).emit("group_created", updatedGroup));
        }

        return res.status(200).json({ message: "Members added", added_user_ids: added, group: updatedGroup });
    } catch (err) {
        console.error("addMembersToGroup error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 7. REMOVE MEMBER OR LEAVE GROUP
const removeOrLeaveGroup = async (req, res) => {
    try {
        const actorId = Number(req.user.id);
        const targetUserId = Number(req.params.userId || actorId);
        const isSelfLeave = actorId === targetUserId;

        const group = await getGroupDetails(req.params.groupId);
        if (!group) return res.status(404).json({ message: "Group not found" });

        const actor = await getMemberRole(group.id, actorId);
        if (!actor) return res.status(403).json({ message: "Not a member" });

        if (!isSelfLeave && actor.role === "member") {
            return res.status(403).json({ message: "Only admins can remove members" });
        }

        const result = await removeGroupMember(group.id, actorId, targetUserId, isSelfLeave);
        if (!result) return res.status(404).json({ message: "Member not found in group" });

        const io = req.app.get("io");
        if (io) {
            io.to(`group_${group.id}`).emit("new_group_message", result.systemMessage);
            io.to(`user_${targetUserId}`).emit("removed_from_group", { group_id: group.id });
        }

        return res.status(200).json({
            message: isSelfLeave ? "You left the group" : "Member removed from group"
        });
    } catch (err) {
        console.error("removeOrLeaveGroup error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 8. PROMOTE / DEMOTE ADMIN (OWNER ONLY)
const changeMemberRole = async (req, res) => {
    try {
        const actorId = Number(req.user.id);
        const targetUserId = Number(req.params.userId);
        const { role } = req.body; // 'admin' or 'member'

        if (!["admin", "member"].includes(role)) {
            return res.status(400).json({ message: "Role must be 'admin' or 'member'" });
        }

        const group = await getGroupDetails(req.params.groupId);
        if (!group) return res.status(404).json({ message: "Group not found" });

        const actor = await getMemberRole(group.id, actorId);
        if (!actor || actor.role !== "owner") {
            return res.status(403).json({ message: "Only group owner can promote/demote admins" });
        }

        const updated = await updateMemberRole(group.id, targetUserId, role);
        if (!updated) return res.status(404).json({ message: "Member not found or cannot change owner role" });

        const io = req.app.get("io");
        if (io) {
            io.to(`group_${group.id}`).emit("member_role_updated", {
                group_id: group.id,
                user_id: targetUserId,
                role
            });
        }

        return res.status(200).json({ message: `Member role updated to ${role}`, data: updated });
    } catch (err) {
        console.error("changeMemberRole error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


// 9. UPDATE GROUP INFO & PERMISSIONS
const editGroupInfo = async (req, res) => {
    try {
        const actorId = Number(req.user.id);
        const group = await getGroupDetails(req.params.groupId);
        if (!group) return res.status(404).json({ message: "Group not found" });

        const actor = await getMemberRole(group.id, actorId);
        if (!actor) return res.status(403).json({ message: "Not a member" });

        if (group.only_admins_can_edit_info && actor.role === "member") {
            return res.status(403).json({ message: "Only admins can edit group info" });
        }

        let groupImageUrl = null;
        const uploadedIcon = req.file || req.files?.media?.[0] || null;
        if (uploadedIcon) {
            const baseUrl = `${req.protocol}://${req.get("host")}`;
            groupImageUrl = `${baseUrl}/uploads/chat/${uploadedIcon.filename}`;
        }

        const updated = await updateGroupSettings(group.id, {
            name: req.body.name,
            description: req.body.description,
            group_image: groupImageUrl,
            only_admins_can_send: req.body.only_admins_can_send,
            only_admins_can_edit_info: req.body.only_admins_can_edit_info
        });

        const io = req.app.get("io");
        if (io) io.to(`group_${group.id}`).emit("group_updated", updated);

        return res.status(200).json({ message: "Group updated", group: updated });
    } catch (err) {
        console.error("editGroupInfo error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


