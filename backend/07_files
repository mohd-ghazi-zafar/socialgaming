// 4. SEND GROUP MESSAGE (TEXT, VOICE NOTE, IMAGE, VIDEO, FILE, MENTIONS)
const postGroupMessage = async (req, res) => {
    try {
        const senderId = Number(req.user.id);
        const group = await getGroupDetails(req.params.groupId);
        if (!group) return res.status(404).json({ message: "Group not found" });

        const membership = await getMemberRole(group.id, senderId);
        if (!membership) return res.status(403).json({ message: "You are not a member of this group" });

        if (group.only_admins_can_send && membership.role === "member") {
            return res.status(403).json({ message: "Only admins can send messages in this group" });
        }

        const { message_type, content, media_duration, waveform, reply_to_message_id, mentions } = req.body;

        const uploadedFile =
            req.file ||
            req.files?.media?.[0] ||
            req.files?.voice?.[0] ||
            null;

        const allowedTypes = ["text", "voice", "image", "video", "file", "sticker"];
        const msgType = message_type && allowedTypes.includes(message_type)
            ? message_type
            : uploadedFile
            ? uploadedFile.mimetype.startsWith("audio/")
                ? "voice"
                : "file"
            : "text";

        let mediaUrl = null;
        let fileName = null;
        let fileSize = null;

        if (uploadedFile) {
            const baseUrl = `${req.protocol}://${req.get("host")}`;
            mediaUrl = `${baseUrl}/uploads/chat/${uploadedFile.filename}`;
            fileName = uploadedFile.originalname;
            fileSize = formatFileSize(uploadedFile.size);
        }

        if (msgType === "text" && (!content || content.trim() === "")) {
            return res.status(400).json({ message: "Message content cannot be empty" });
        }

        let parsedWaveform = [];
        if (waveform) {
            try { parsedWaveform = typeof waveform === "string" ? JSON.parse(waveform) : waveform; } catch (_) {}
        }

        let parsedMentions = [];
        if (mentions) {
            try { parsedMentions = typeof mentions === "string" ? JSON.parse(mentions) : mentions; } catch (_) {}
        }

        const savedMessage = await sendGroupMessage({
            group_id: group.id,
            sender_id: senderId,
            message_type: msgType,
            content: content ? content.trim() : null,
            media_url: mediaUrl,
            media_duration: media_duration ? parseInt(media_duration, 10) : null,
            waveform: parsedWaveform,
            file_name: fileName,
            file_size: fileSize,
            reply_to_message_id: reply_to_message_id ? parseInt(reply_to_message_id, 10) : null,
            mentions: parsedMentions
        });

        // Emit live to everyone inside `group_${group.id}` and each member's personal room
        const io = req.app.get("io");
        if (io) {
            io.to(`group_${group.id}`).emit("new_group_message", savedMessage);
            group.members.forEach((m) => {
                if (Number(m.user_id) !== senderId) {
                    io.to(`user_${m.user_id}`).emit("group_inbox_updated", {
                        group_id: group.id,
                        group_uid: group.group_uid,
                        message: savedMessage
                    });
                }
            });
        }

        return res.status(201).json({
            message: msgType === "voice" ? "Group voice note sent" : "Group message sent",
            data: savedMessage
        });
    } catch (err) {
        console.error("postGroupMessage error:", err.message);
        return res.status(500).json({ message: "Server error", error: err.message });
    }
};


