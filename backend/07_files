const pool = require("../../config/connection");

// =====================================================
// CREATE GROUP CHAT TABLES
// =====================================================
(async () => {
    try {
        // 1. Groups Table
        await pool.query(`
            CREATE TABLE IF NOT EXISTS groups (
                id SERIAL PRIMARY KEY,
                group_uid VARCHAR(50) UNIQUE NOT NULL,       -- e.g., GRP-482910-2026
                name VARCHAR(120) NOT NULL,
                description TEXT,
                group_image TEXT,
                created_by INT NOT NULL,
                invite_code VARCHAR(32) UNIQUE NOT NULL,

                only_admins_can_send BOOLEAN DEFAULT FALSE,
                only_admins_can_edit_info BOOLEAN DEFAULT TRUE,

                last_message TEXT,
                last_message_type VARCHAR(30) DEFAULT 'system',
                last_message_sender_name VARCHAR(120),
                last_message_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

                FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE CASCADE
            );
        `);

        // 2. Group Members Table (Roles, Unread Count, Mute)
        await pool.query(`
            CREATE TABLE IF NOT EXISTS group_members (
                id SERIAL PRIMARY KEY,
                group_id INT NOT NULL,
                user_id INT NOT NULL,
                role VARCHAR(20) DEFAULT 'member'
                    CHECK (role IN ('owner', 'admin', 'member')),
                unread_count INT DEFAULT 0,
                is_muted BOOLEAN DEFAULT FALSE,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

                FOREIGN KEY (group_id) REFERENCES groups(id) ON DELETE CASCADE,
                FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
                UNIQUE (group_id, user_id)
            );
        `);

        // 3. Group Messages Table (Text, Voice Notes, Media, System Events)
        await pool.query(`
            CREATE TABLE IF NOT EXISTS group_messages (
                id SERIAL PRIMARY KEY,
                group_id INT NOT NULL,
                sender_id INT NOT NULL,

                message_type VARCHAR(30) NOT NULL DEFAULT 'text'
                    CHECK (message_type IN ('text', 'voice', 'image', 'video', 'file', 'sticker', 'system')),

                content TEXT,
                media_url TEXT,
                media_duration INT,
                waveform JSONB DEFAULT '[]'::jsonb,
                file_name VARCHAR(255),
                file_size VARCHAR(50),

                reply_to_message_id INT,
                mentions JSONB DEFAULT '[]'::jsonb,          -- [userId1, userId2]
                reactions JSONB DEFAULT '{}'::jsonb,         -- { "userId": "🔥" }
                read_by JSONB DEFAULT '[]'::jsonb,           -- [{ "user_id": 2, "read_at": "..." }]

                is_edited BOOLEAN DEFAULT FALSE,
                is_pinned BOOLEAN DEFAULT FALSE,
                is_deleted_for_everyone BOOLEAN DEFAULT FALSE,
                deleted_for_users JSONB DEFAULT '[]'::jsonb,

                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

                FOREIGN KEY (group_id) REFERENCES groups(id) ON DELETE CASCADE,
                FOREIGN KEY (sender_id) REFERENCES users(id) ON DELETE CASCADE,
                FOREIGN KEY (reply_to_message_id) REFERENCES group_messages(id) ON DELETE SET NULL
            );
        `);

        await pool.query(`
            CREATE INDEX IF NOT EXISTS idx_group_messages_group_id ON group_messages(group_id, created_at DESC);
            CREATE INDEX IF NOT EXISTS idx_group_members_user_id ON group_members(user_id);
        `);

        console.log("Groups, group_members, and group_messages tables ready");
    } catch (err) {
        console.error("Error creating group chat tables:", err.message);
    }
})();


// =====================================================
// 1. CREATE A NEW GROUP & ADD INITIAL MEMBERS
// =====================================================
const createGroup = async ({ group_uid, name, description, group_image, created_by, invite_code, member_ids = [] }) => {
    const client = await pool.connect();
    try {
        await client.query("BEGIN");

        const groupRes = await client.query(
            `
            INSERT INTO groups (group_uid, name, description, group_image, created_by, invite_code, last_message, last_message_type)
            VALUES ($1, $2, $3, $4, $5, $6, 'Group created', 'system')
            RETURNING *
            `,
            [group_uid, name, description || null, group_image || null, created_by, invite_code]
        );
        const group = groupRes.rows[0];

        // Add creator as 'owner'
        await client.query(
            `INSERT INTO group_members (group_id, user_id, role) VALUES ($1, $2, 'owner')`,
            [group.id, created_by]
        );

        // Deduplicate & add initial members
        const uniqueMembers = [...new Set(member_ids.map(Number))].filter((id) => id && id !== Number(created_by));
        for (const memberId of uniqueMembers) {
            await client.query(
                `
                INSERT INTO group_members (group_id, user_id, role)
                VALUES ($1, $2, 'member')
                ON CONFLICT (group_id, user_id) DO NOTHING
                `,
                [group.id, memberId]
            );
        }

        // Insert system welcome message
        await client.query(
            `
            INSERT INTO group_messages (group_id, sender_id, message_type, content)
            VALUES ($1, $2, 'system', $3)
            `,
            [group.id, created_by, `Created group "${name}"`]
        );

        await client.query("COMMIT");
        return await getGroupDetails(group.id);
    } catch (err) {
        await client.query("ROLLBACK");
        throw err;
    } finally {
        client.release();
    }
};


// =====================================================
// 2. GET GROUP DETAILS + FULL MEMBER LIST
// =====================================================
const getGroupDetails = async (identifier) => {
    const isNumeric = /^\d+$/.test(String(identifier));
    const column = isNumeric ? "g.id" : "g.group_uid";

    const groupRes = await pool.query(
        `SELECT g.* FROM groups g WHERE ${column} = $1 LIMIT 1`,
        [identifier]
    );
    const group = groupRes.rows[0];
    if (!group) return null;

    const membersRes = await pool.query(
        `
        SELECT
            gm.user_id,
            gm.role,
            gm.is_muted,
            gm.joined_at,
            u.user_uid,
            u.name,
            u.profile_image,
            u.is_online,
            u.last_seen
        FROM group_members gm
        JOIN users u ON u.id = gm.user_id
        WHERE gm.group_id = $1
        ORDER BY
            CASE gm.role WHEN 'owner' THEN 1 WHEN 'admin' THEN 2 ELSE 3 END,
            gm.joined_at ASC
        `,
        [group.id]
    );

    return {
        ...group,
        member_count: membersRes.rows.length,
        members: membersRes.rows
    };
};


// =====================================================
// 3. CHECK MEMBER ROLE IN GROUP
// =====================================================
const getMemberRole = async (groupId, userId) => {
    const res = await pool.query(
        `SELECT role, is_muted FROM group_members WHERE group_id = $1 AND user_id = $2 LIMIT 1`,
        [groupId, Number(userId)]
    );
    return res.rows[0] || null;
};


// =====================================================
// 4. GET USER'S GROUP LIST (GROUP INBOX)
// =====================================================
const getUserGroups = async (userId) => {
    const result = await pool.query(
        `
        SELECT
            g.id AS group_id,
            g.group_uid,
            g.name,
            g.description,
            g.group_image,
            g.last_message,
            g.last_message_type,
            g.last_message_sender_name,
            g.last_message_at,
            gm.role,
            gm.unread_count,
            gm.is_muted,
            (SELECT COUNT(*)::int FROM group_members WHERE group_id = g.id) AS member_count
        FROM group_members gm
        JOIN groups g ON g.id = gm.group_id
        WHERE gm.user_id = $1
        ORDER BY g.last_message_at DESC
        `,
        [Number(userId)]
    );
    return result.rows;
};


// =====================================================
// 5. ADD MEMBERS TO GROUP
// =====================================================
const addGroupMembers = async (groupId, addedByUserId, userIds = []) => {
    const addedUsers = [];
    for (const uid of userIds) {
        const res = await pool.query(
            `
            INSERT INTO group_members (group_id, user_id, role)
            VALUES ($1, $2, 'member')
            ON CONFLICT (group_id, user_id) DO NOTHING
            RETURNING user_id
            `,
            [groupId, Number(uid)]
        );
        if (res.rows[0]) addedUsers.push(Number(uid));
    }

    if (addedUsers.length > 0) {
        const namesRes = await pool.query(
            `SELECT name FROM users WHERE id = ANY($1::int[])`,
            [addedUsers]
        );
        const namesList = namesRes.rows.map((r) => r.name).join(", ");
        await sendGroupMessage({
            group_id: groupId,
            sender_id: addedByUserId,
            message_type: "system",
            content: `Added ${namesList} to the group`
        });
    }

    return addedUsers;
};


// =====================================================
// 6. REMOVE MEMBER OR LEAVE GROUP
// =====================================================
const removeGroupMember = async (groupId, actorId, targetUserId, isSelfLeave = false) => {
    const targetUserRes = await pool.query(`SELECT name FROM users WHERE id = $1`, [targetUserId]);
    const targetName = targetUserRes.rows[0]?.name || "Member";

    const delRes = await pool.query(
        `DELETE FROM group_members WHERE group_id = $1 AND user_id = $2 RETURNING *`,
        [groupId, Number(targetUserId)]
    );

    if (!delRes.rows[0]) return null;

    const systemText = isSelfLeave ? `${targetName} left the group` : `Removed ${targetName} from the group`;
    const sysMsg = await sendGroupMessage({
        group_id: groupId,
        sender_id: actorId,
        message_type: "system",
        content: systemText
    });

    return { removed: delRes.rows[0], systemMessage: sysMsg };
};


// =====================================================
// 7. PROMOTE / DEMOTE GROUP ADMIN
// =====================================================
const updateMemberRole = async (groupId, targetUserId, newRole) => {
    const res = await pool.query(
        `
        UPDATE group_members
        SET role = $1
        WHERE group_id = $2 AND user_id = $3 AND role != 'owner'
        RETURNING *
        `,
        [newRole, groupId, Number(targetUserId)]
    );
    return res.rows[0] || null;
};


// =====================================================
// 8. UPDATE GROUP SETTINGS / INFO
// =====================================================
const updateGroupSettings = async (groupId, updates) => {
    const { name, description, group_image, only_admins_can_send, only_admins_can_edit_info } = updates;
    const res = await pool.query(
        `
        UPDATE groups
        SET
            name = COALESCE($1, name),
            description = COALESCE($2, description),
            group_image = COALESCE($3, group_image),
            only_admins_can_send = COALESCE($4, only_admins_can_send),
            only_admins_can_edit_info = COALESCE($5, only_admins_can_edit_info),
            updated_at = CURRENT_TIMESTAMP
        WHERE id = $6
        RETURNING *
        `,
        [name, description, group_image, only_admins_can_send, only_admins_can_edit_info, groupId]
    );
    return res.rows[0] || null;
};


// =====================================================
// 9. JOIN GROUP VIA INVITE CODE
// =====================================================
const joinGroupByInviteCode = async (inviteCode, userId) => {
    const groupRes = await pool.query(`SELECT * FROM groups WHERE invite_code = $1 LIMIT 1`, [inviteCode]);
    const group = groupRes.rows[0];
    if (!group) return null;

    await pool.query(
        `
        INSERT INTO group_members (group_id, user_id, role)
        VALUES ($1, $2, 'member')
        ON CONFLICT (group_id, user_id) DO NOTHING
        `,
        [group.id, Number(userId)]
    );

    const userRes = await pool.query(`SELECT name FROM users WHERE id = $1`, [userId]);
    await sendGroupMessage({
        group_id: group.id,
        sender_id: userId,
        message_type: "system",
        content: `${userRes.rows[0]?.name || "A player"} joined via invite link`
    });

    return await getGroupDetails(group.id);
};


// =====================================================
// 10. SEND GROUP MESSAGE (TEXT, VOICE, MEDIA, MENTIONS)
// =====================================================
const sendGroupMessage = async (msgData) => {
    const {
        group_id,
        sender_id,
        message_type = "text",
        content = null,
        media_url = null,
        media_duration = null,
        waveform = [],
        file_name = null,
        file_size = null,
        reply_to_message_id = null,
        mentions = []
    } = msgData;

    const initialReadBy = JSON.stringify([{ user_id: Number(sender_id), read_at: new Date().toISOString() }]);

    const insertRes = await pool.query(
        `
        INSERT INTO group_messages (
            group_id, sender_id, message_type, content, media_url, media_duration,
            waveform, file_name, file_size, reply_to_message_id, mentions, read_by
        )
        VALUES ($1, $2, $3, $4, $5, $6, $7::jsonb, $8, $9, $10, $11::jsonb, $12::jsonb)
        RETURNING id
        `,
        [
            group_id,
            sender_id,
            message_type,
            content,
            media_url,
            media_duration,
            JSON.stringify(Array.isArray(waveform) ? waveform : []),
            file_name,
            file_size,
            reply_to_message_id,
            JSON.stringify(Array.isArray(mentions) ? mentions : []),
            initialReadBy
        ]
    );

    const newMsgId = insertRes.rows[0].id;

    // Fetch full hydrated message
    const fullRes = await pool.query(
        `
        SELECT
            m.*,
            sender.name AS sender_name,
            sender.user_uid AS sender_uid,
            sender.profile_image AS sender_image,
            reply.content AS reply_content,
            reply.message_type AS reply_message_type,
            reply.sender_id AS reply_sender_id
        FROM group_messages m
        JOIN users sender ON sender.id = m.sender_id
        LEFT JOIN group_messages reply ON reply.id = m.reply_to_message_id
        WHERE m.id = $1
        `,
        [newMsgId]
    );
    const hydratedMessage = fullRes.rows[0];

    const previewText =
        message_type === "text" || message_type === "system"
            ? content
            : message_type === "voice"
            ? `🎤 Voice message (${media_duration || 0}s)`
            : message_type === "image"
            ? "📷 Photo"
            : message_type === "video"
            ? "🎥 Video"
            : message_type === "sticker"
            ? "💟 Sticker"
            : `📎 ${file_name || "File"}`;

    // Update group's last message preview
    await pool.query(
        `
        UPDATE groups
        SET
            last_message = $1,
            last_message_type = $2,
            last_message_sender_name = $3,
            last_message_at = CURRENT_TIMESTAMP,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = $4
        `,
        [previewText, message_type, hydratedMessage.sender_name, group_id]
    );

    // Increment unread_count for all group members except sender
    if (message_type !== "system") {
        await pool.query(
            `
            UPDATE group_members
            SET unread_count = unread_count + 1
            WHERE group_id = $1 AND user_id != $2
            `,
            [group_id, Number(sender_id)]
        );
    }

    return hydratedMessage;
};


// =====================================================
// 11. GET PAGINATED GROUP CHAT HISTORY
// =====================================================
const getGroupMessages = async (groupId, currentUserId, limit = 50, offset = 0) => {
    const result = await pool.query(
        `
        SELECT
            m.*,
            sender.name AS sender_name,
            sender.user_uid AS sender_uid,
            sender.profile_image AS sender_image,
            reply.content AS reply_content,
            reply.message_type AS reply_message_type,
            reply.sender_id AS reply_sender_id
        FROM group_messages m
        JOIN users sender ON sender.id = m.sender_id
        LEFT JOIN group_messages reply ON reply.id = m.reply_to_message_id
        WHERE m.group_id = $1
          AND NOT (m.deleted_for_users @> to_jsonb($2::int))
        ORDER BY m.created_at DESC
        LIMIT $3 OFFSET $4
        `,
        [groupId, Number(currentUserId), limit, offset]
    );
    return result.rows.reverse();
};


// =====================================================
// 12. MARK GROUP MESSAGES AS READ (RESET UNREAD + READ_BY)
// =====================================================
const markGroupRead = async (groupId, readerId) => {
    const uid = Number(readerId);

    // Reset unread badge for this user
    await pool.query(
        `UPDATE group_members SET unread_count = 0 WHERE group_id = $1 AND user_id = $2`,
        [groupId, uid]
    );

    // Append reader to read_by JSONB on recent unread messages
    const readEntry = JSON.stringify([{ user_id: uid, read_at: new Date().toISOString() }]);
    const updated = await pool.query(
        `
        UPDATE group_messages
        SET read_by = read_by || $1::jsonb
        WHERE group_id = $2
          AND sender_id != $3
          AND NOT EXISTS (
              SELECT 1 FROM jsonb_array_elements(read_by) elem
              WHERE (elem->>'user_id')::int = $3
          )
        RETURNING id
        `,
        [readEntry, groupId, uid]
    );

    return updated.rows.map((r) => r.id);
};


// =====================================================
// 13. REACT, EDIT, DELETE & PIN GROUP MESSAGES
// =====================================================
const toggleGroupReaction = async (messageId, userId, emoji) => {
    const existing = await pool.query(`SELECT reactions, group_id FROM group_messages WHERE id = $1`, [messageId]);
    if (!existing.rows[0]) return null;

    const reactions = existing.rows[0].reactions || {};
    const key = String(userId);
    if (!emoji || reactions[key] === emoji) {
        delete reactions[key];
    } else {
        reactions[key] = emoji;
    }

    const res = await pool.query(
        `UPDATE group_messages SET reactions = $1::jsonb, updated_at = CURRENT_TIMESTAMP WHERE id = $2 RETURNING *`,
        [JSON.stringify(reactions), messageId]
    );
    return res.rows[0];
};

const editGroupMessage = async (messageId, senderId, newContent) => {
    const res = await pool.query(
        `
        UPDATE group_messages
        SET content = $1, is_edited = TRUE, updated_at = CURRENT_TIMESTAMP
        WHERE id = $2 AND sender_id = $3 AND message_type = 'text' AND is_deleted_for_everyone = FALSE
        RETURNING *
        `,
        [newContent, messageId, senderId]
    );
    return res.rows[0] || null;
};

const deleteGroupMessage = async (messageId, userId, isAdminOrOwner = false, deleteForEveryone = false) => {
    if (deleteForEveryone) {
        // Sender OR group admin/owner can delete for everyone
        const query = isAdminOrOwner
            ? `UPDATE group_messages SET content = 'This message was deleted', media_url = NULL, is_deleted_for_everyone = TRUE, updated_at = CURRENT_TIMESTAMP WHERE id = $1 RETURNING *`
            : `UPDATE group_messages SET content = 'This message was deleted', media_url = NULL, is_deleted_for_everyone = TRUE, updated_at = CURRENT_TIMESTAMP WHERE id = $1 AND sender_id = $2 RETURNING *`;
        const params = isAdminOrOwner ? [messageId] : [messageId, userId];
        const res = await pool.query(query, params);
        return res.rows[0] || null;
    }

    const res = await pool.query(
        `
        UPDATE group_messages
        SET deleted_for_users = CASE
            WHEN NOT (deleted_for_users @> to_jsonb($2::int)) THEN deleted_for_users || to_jsonb($2::int)
            ELSE deleted_for_users
        END
        WHERE id = $1
        RETURNING *
        `,
        [messageId, Number(userId)]
    );
    return res.rows[0] || null;
};

const togglePinGroupMessage = async (messageId) => {
    const res = await pool.query(
        `UPDATE group_messages SET is_pinned = NOT is_pinned, updated_at = CURRENT_TIMESTAMP WHERE id = $1 RETURNING *`,
        [messageId]
    );
    return res.rows[0] || null;
};

const searchGroupMessages = async (groupId, currentUserId, searchTerm) => {
    const res = await pool.query(
        `
        SELECT * FROM group_messages
        WHERE group_id = $1
          AND is_deleted_for_everyone = FALSE
          AND NOT (deleted_for_users @> to_jsonb($2::int))
          AND content ILIKE $3
        ORDER BY created_at DESC
        `,
        [groupId, Number(currentUserId), `%${searchTerm}%`]
    );
    return res.rows;
};

