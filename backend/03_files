const pool = require("../../config/connection");

// =====================================================
// CREATE FOLLOW REQUESTS TABLE
// =====================================================
(async () => {
    try {
        await pool.query(`
            CREATE TABLE IF NOT EXISTS follow_requests (

                id SERIAL PRIMARY KEY,

                sender_id INT NOT NULL,           -- Who sent the request
                receiver_id INT NOT NULL,         -- Who received the request

                status VARCHAR(20) DEFAULT 'pending'
                    CHECK (status IN ('pending', 'accepted', 'rejected')),

                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

                FOREIGN KEY (sender_id) REFERENCES users(id) ON DELETE CASCADE,
                FOREIGN KEY (receiver_id) REFERENCES users(id) ON DELETE CASCADE,

                UNIQUE (sender_id, receiver_id),
                CHECK (sender_id != receiver_id)
            );
        `);

        console.log("Follow Requests table ready");
    } catch (err) {
        console.error("Error creating follow_requests table:", err.message);
    }
})();


// =====================================================
// CREATE FOLLOWS TABLE (Only accepted follows)
// =====================================================
(async () => {
    try {
        await pool.query(`
            CREATE TABLE IF NOT EXISTS follows (

                id SERIAL PRIMARY KEY,

                follower_id INT NOT NULL,
                following_id INT NOT NULL,

                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

                FOREIGN KEY (follower_id) REFERENCES users(id) ON DELETE CASCADE,
                FOREIGN KEY (following_id) REFERENCES users(id) ON DELETE CASCADE,

                UNIQUE (follower_id, following_id),
                CHECK (follower_id != following_id)
            );
        `);

        console.log("Follows table ready");
    } catch (err) {
        console.error("Error creating follows table:", err.message);
    }
})();


// =====================================================
// 1. SEND FOLLOW REQUEST
// =====================================================
const sendFollowRequest = async (senderId, receiverId) => {
    try {
        const result = await pool.query(
            `
            INSERT INTO follow_requests (sender_id, receiver_id, status)
            VALUES ($1, $2, 'pending')
            ON CONFLICT (sender_id, receiver_id)
            DO UPDATE SET status = 'pending', updated_at = CURRENT_TIMESTAMP
            WHERE follow_requests.status != 'accepted'
            RETURNING *
            `,
            [senderId, receiverId]
        );
        return result.rows[0];
    } catch (err) {
        throw err;
    }
};


// =====================================================
// 2. ACCEPT FOLLOW REQUEST
// =====================================================
const acceptFollowRequest = async (requestId, receiverId) => {
    try {
        // First check the request
        const request = await pool.query(
            `
            SELECT * FROM follow_requests
            WHERE id = $1 AND receiver_id = $2 AND status = 'pending'
            `,
            [requestId, receiverId]
        );

        if (request.rows.length === 0) {
            return null;
        }

        const { sender_id, receiver_id } = request.rows[0];

        // Update request status
        await pool.query(
            `
            UPDATE follow_requests
            SET status = 'accepted', updated_at = CURRENT_TIMESTAMP
            WHERE id = $1
            `,
            [requestId]
        );

        // Insert into follows table (safely avoid duplicates)
        const follow = await pool.query(
            `
            INSERT INTO follows (follower_id, following_id)
            VALUES ($1, $2)
            ON CONFLICT (follower_id, following_id) DO NOTHING
            RETURNING *
            `,
            [sender_id, receiver_id]
        );

        return follow.rows[0] || { follower_id: sender_id, following_id: receiver_id };
    } catch (err) {
        throw err;
    }
};


