// =====================================================
// 1. SEND FOLLOW REQUEST
// POST /api/follow/request/:userId
// =====================================================
const sendRequest = async (req, res) => {
    try {
        const senderId = req.user.id;
        const receiverId = req.params.userId;

        if (senderId == receiverId) {
            return res.status(400).json({
                message: "You cannot send follow request to yourself"
            });
        }

        // Check if already following
        const alreadyFollowing = await isFollowing(senderId, receiverId);
        if (alreadyFollowing) {
            return res.status(400).json({
                message: "You are already following this user"
            });
        }

        // Check if request already exists
        const existingStatus = await getRequestStatus(senderId, receiverId);
        if (existingStatus === "pending") {
            return res.status(400).json({
                message: "Follow request already sent"
            });
        }
        if (existingStatus === "accepted") {
            return res.status(400).json({
                message: "You are already following this user"
            });
        }

        const result = await sendFollowRequest(senderId, receiverId);

        return res.status(201).json({
            message: "Follow request sent successfully",
            data: result
        });

    } catch (err) {
        console.error("sendRequest error:", err.message);

        if (err.code === "23505") {
            return res.status(400).json({
                message: "Follow request already sent"
            });
        }

        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};


// =====================================================
// 2. ACCEPT FOLLOW REQUEST
// PUT /api/follow/accept/:requestId
// =====================================================
const acceptRequest = async (req, res) => {
    try {
        const receiverId = req.user.id;
        const requestId = req.params.requestId;

        const result = await acceptFollowRequest(requestId, receiverId);

        if (!result) {
            return res.status(404).json({
                message: "Follow request not found or already handled"
            });
        }

        return res.status(200).json({
            message: "Follow request accepted successfully",
            data: result
        });

    } catch (err) {
        console.error("acceptRequest error:", err.message);
        return res.status(500).json({
            message: "Server error",
            error: err.message
        });
    }
};


