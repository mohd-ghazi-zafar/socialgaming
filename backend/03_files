                u.id,
                u.user_uid AS unique_id,
                u.name,
                u.profile_image,
                f.created_at AS followed_at
            FROM follows f
            JOIN users u ON u.id = f.follower_id
            WHERE f.following_id = $1
            ORDER BY f.created_at DESC
            `,
            [userId]
        );
        return result.rows;
    } catch (err) {
