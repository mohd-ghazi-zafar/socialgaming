const express = require("express");
const router = express.Router();

const {
    sendRequest,
    acceptRequest,
    rejectRequest,
    unfollow,
    viewPendingRequests,
    viewFollowers,
    viewFollowing,
    viewFollowStats,
    viewFollowersCount,
    viewFollowingCount,
    checkStatus
} = require("../controller/UserProfile/followersController");


const { verifyToken } = require("../middleware/jwtauthication");

// =====================================================
// FOLLOW REQUEST ROUTES
// =====================================================

// Send follow request
// POST /api/follow/request/:userId
router.post("/request/:userId", verifyToken, sendRequest);

// Accept follow request
// PUT /api/follow/accept/:requestId
router.put("/accept/:requestId", verifyToken, acceptRequest);

// Reject follow request (supports both DELETE and PUT for client compatibility)
// DELETE /api/follow/reject/:requestId
router.delete("/reject/:requestId", verifyToken, rejectRequest);
router.put("/reject/:requestId", verifyToken, rejectRequest);

// Unfollow user
// DELETE /api/follow/:userId
router.delete("/:userId", verifyToken, unfollow);

// Get pending follow requests (received by logged-in user)
// GET /api/follow/requests
router.get("/requests", verifyToken, viewPendingRequests);

// Get followers list (logged-in user via /my or any user via /:userId)
// GET /api/follow/followers/my or /api/follow/followers/:userId
router.get("/followers/my", verifyToken, viewFollowers);
router.get("/followers/:userId", verifyToken, viewFollowers);

// Get following list (logged-in user via /my or any user via /:userId)
// GET /api/follow/following/my or /api/follow/following/:userId
router.get("/following/my", verifyToken, viewFollowing);
router.get("/following/:userId", verifyToken, viewFollowing);

// Get follow stats (followers + following count)
// GET /api/follow/stats/combine or /api/follow/stats/:userId
