    try {
        const result = await pool.query(
            `
            DELETE FROM follows
            WHERE follower_id = $1 AND following_id = $2
            RETURNING *
            `,
            [followerId, followingId]
        );
        return result.rows[0] || null;
    } catch (err) {
        throw err;
    }
};


